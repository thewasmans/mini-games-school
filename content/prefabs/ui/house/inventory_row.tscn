script = ExtResource("1")
title_label = NodePath("Layout/Text/Title")
status_label = NodePath("Layout/Text/Status")
bar = NodePath("Layout/Text/Gauge/Bar")
value_label = NodePath("Layout/Text/Gauge/Value")
action_button = NodePath("Layout/ActionButton")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Text" type="VBoxContainer" parent="Layout"]
