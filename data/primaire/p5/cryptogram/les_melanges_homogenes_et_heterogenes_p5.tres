[sub_resource type="Resource" id="Resource_dbqm1"]
script = ExtResource("1_yoikg")
text = "On peut distinguer les constituants d’un mélange homogène."

[sub_resource type="Resource" id="Resource_7ux6v"]
script = ExtResource("1_yoikg")
text = "On ne peut pas distinguer les constituants d’un mélange hétérogène."

[sub_resource type="Resource" id="Resource_pk2mn"]
script = ExtResource("1_yoikg")
text = "L’eau et l’huile forment un mélange hétérogène."

[sub_resource type="Resource" id="Resource_1stwc"]
script = ExtResource("1_yoikg")
text = "L’eau et la grenadine forment un mélange homogène."

[sub_resource type="Resource" id="Resource_7ihrx"]
script = ExtResource("1_yoikg")
text = "Le dioxyde de carbone est un gaz présent dans l’air."

[sub_resource type="Resource" id="Resource_grp5d"]
script = ExtResource("1_yoikg")
text = "Des objets de même volume peuvent avoir une masse différente. "

[sub_resource type="Resource" id="Resource_tux6b"]
script = ExtResource("1_yoikg")
text = "Le volume d’un objet comme étant l’espace occupé par l’objet."

[sub_resource type="Resource" id="Resource_dt2xc"]
