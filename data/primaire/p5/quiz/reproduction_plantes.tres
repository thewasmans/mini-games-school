[sub_resource type="Resource" id="Resource_p810h"]
script = ExtResource("1_fsu2w")
question = "Qu’est-ce que la pollinisation ?"
choices = Array[String](["La chute des feuilles.", "Le transport de pollen.", "La croissance des racines.", "La fabrication des graines."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_r8qqg"]
script = ExtResource("1_fsu2w")
question = "Quelle est la première phase de la germination ?"
choices = Array[String](["C’est la mort de la plante.", "C’est le début de croissance d’une nouvelle plante.", "C’est la fabrication du pollen.", "C’est le chute des fruits."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_u7i8p"]
script = ExtResource("1_fsu2w")
question = "Quelle est la première étape de la reproduction d’une plante à fleurs ?"
choices = Array[String](["La mort.", "La pollinisation.", "La germination.", "La croissance."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_yynvb"]
script = ExtResource("1_fsu2w")
question = "Comment est transporté le pollen ?"
choices = Array[String](["Des organes mâles vers les organes femelles.", "Des racines vers les feuilles.", "Des fruits vers les graines.", "Des feuilles vers la tige."])

[sub_resource type="Resource" id="Resource_mp8bv"]
script = ExtResource("1_fsu2w")
question = "Quand a lieu la fécondation ?"
choices = Array[String](["Quand la fleur tombe.", "Quand un grain de pollen rencontre un ovule.", "Quand une graine pousse.", "Quand une feuille grandit."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_td0ua"]
script = ExtResource("1_fsu2w")
question = "Après la fécondation, en quoi la fleur se transforme-t-elle ?"
choices = Array[String](["En pierre.", "En fruit.", "En nuage.", "En arbre."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_gwq0y"]
script = ExtResource("1_fsu2w")
question = "Dans quelle partie trouve-t-on les graines ?"
choices = Array[String](["Dans les racines.", "Dans les feuilles.", "Dans le fruit.", "Dans la tige."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_t22lh"]
script = ExtResource("1_fsu2w")
question = "Quel est l'ordre chronologique des étapes de vie d'une plante à fleurs ?"
choices = Array[String](["Fruit – pollinisation – mort – germination.", "Mort – croissance – pollinisation – graine.", "Pollinisation – fécondation – fruit – germination.", "Germination – mort – fleur – fruit."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_o31v2"]
