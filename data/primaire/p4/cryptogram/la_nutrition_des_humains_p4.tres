[sub_resource type="Resource" id="Resource_rqkdm"]
script = ExtResource("1_2456h")
text = "Les humains sont constitués de matière."

[sub_resource type="Resource" id="Resource_3o1f6"]
script = ExtResource("1_2456h")
text = "S’alimenter permet de  produire de la matière et de l’énergie."

[sub_resource type="Resource" id="Resource_jjdkv"]
script = ExtResource("1_2456h")
text = "Il est important d’avoir une alimentation saine."

[sub_resource type="Resource" id="Resource_23o45"]
script = ExtResource("1_2456h")
text = "Le sommeil est indispensable à notre bien-être."

[sub_resource type="Resource" id="Resource_353g5"]
script = ExtResource("1_2456h")
text = "La digestion est un processus de transformation."

[sub_resource type="Resource" id="Resource_h5lbl"]
script = ExtResource("1_2456h")
text = "Le sang permet de transporter les nutriments."

[sub_resource type="Resource" id="Resource_53j5o"]
script = ExtResource("1_2456h")
text = "Le tube digestif va de la bouche à l’anus."

[sub_resource type="Resource" id="Resource_dkx5q"]
script = ExtResource("1_2456h")
text = "L’estomac est un organe de stockage."

[sub_resource type="Resource" id="Resource_o2o5c"]
