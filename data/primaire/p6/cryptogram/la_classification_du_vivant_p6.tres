[sub_resource type="Resource" id="Resource_qtkap"]
script = ExtResource("1_xpcga")
text = "Le classement actuel est dit phylogénétique."

[sub_resource type="Resource" id="Resource_auxm7"]
script = ExtResource("1_xpcga")
text = "Deux mêmes espèces peuvent se reproduire."

[sub_resource type="Resource" id="Resource_qql4t"]
script = ExtResource("1_xpcga")
text = "On nomme attribut la caractéristique d’une espèce."

[sub_resource type="Resource" id="Resource_jiq1e"]
script = ExtResource("1_xpcga")
text = "On utilise des groupes emboîtés pour le classement."

[sub_resource type="Resource" id="Resource_22q5x"]
script = ExtResource("1_xpcga")
text = "Les vertébrés possèdent une colonne vertébrale."

[sub_resource type="Resource" id="Resource_ogllj"]
script = ExtResource("1_xpcga")
text = "Les insectes ont six pattes."

[sub_resource type="Resource" id="Resource_2lo5b"]
script = ExtResource("1_xpcga")
text = "Les requins sont des poissons."

[sub_resource type="Resource" id="Resource_i70gi"]
script = ExtResource("1_xpcga")
text = "Les dauphins sont des mammifères."

[sub_resource type="Resource" id="Resource_n4wpd"]
script = ExtResource("1_xpcga")
text = "Le terme reptile n’est plus utilisé."

