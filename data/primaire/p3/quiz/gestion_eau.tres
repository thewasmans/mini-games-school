[sub_resource type="Resource" id="Resource_nephy"]
script = ExtResource("1_dqp0s")
question = "Que se passe-t-il si on laisse un robinet qui goutte ?"
choices = Array[String](["Cela ne consomme rien.", "Cela gaspille beaucoup d'eau sur une année.", "Cela fait fonctionner le chauffe-eau.", "Cela fait grandir les fleurs du jardin."])
correct_choice_index = 1

