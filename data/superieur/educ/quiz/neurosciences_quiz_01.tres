question = "Quel est l'effet principal du cortisol libéré par le cortex surrénalien en situation de stress ?"
choices = Array[String](["Il provoque une diminution immédiate de la pression sanguine.", "Il induit un sommeil profond et réparateur.", "Il permet au foie de décomposer le glycogène pour libérer du glucose dans le sang.", "Il bloque totalement la transmission des influx nerveux."])
correct_choice_index = 2

