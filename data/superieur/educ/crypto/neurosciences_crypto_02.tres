[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_l08hy")
text = "Le cerveau est le centre du système nerveux organisé en six couches."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_l08hy")
text = "Les deux hémisphères cérébraux sont réunis par le corps calleux."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_l08hy")
text = "Le nutriment principal utilisé par le cerveau très vascularisé est le glucose."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_l08hy")
text = "La matière grise correspond aux corps cellulaires des neurones."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_l08hy")
text = "La substance blanche correspond aux axones et aux fibres nerveuses myélinisées."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_l08hy")
text = "Le cerveau se développe en utilisant de l'iode provenant des hormones thyroïdiennes."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_l08hy")
text = "Le cortex préfrontal permet de raisonner mais n'arrive à maturité qu'à vingt-cinq ans."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_l08hy")
text = "Le cortex préfrontal se développe et permet de mieux gérer ses émotions."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_l08hy")
text = "Le lobe frontal est impliqué dans la motricité et la pensée."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_l08hy")
text = "Le cervelet assure nos mouvements coordonnés et notre équilibre lors de la marche."

