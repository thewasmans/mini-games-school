[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_a31gf")
text = "Le sommeil permet la régulation des états émotionnels et de la santé cérébrale."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_a31gf")
text = "L'hypothalamus contrôle la conscience, l'éveil ainsi que le sommeil de l'organisme."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_a31gf")
text = "L'épiphyse sécrète la mélatonine, qui est l'hormone de l'obscurité et du sommeil."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_a31gf")
text = "La formation réticulée du tronc cérébral maintient l'état de veille et filtre l'attention."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_a31gf")
text = "Le réseau de mode par défaut s'active lorsque nous sommes orientés vers nos pensées."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_a31gf")
text = "La privation de sommeil perturbe durablement les fonctions cognitives et exécutives supérieures."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_a31gf")
text = "Les cycles du sommeil alternent entre sommeil lent et sommeil paradoxal onirique."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_a31gf")
text = "Le sommeil paradoxal est la phase privilégiée de survenue des rêves visuels intenses."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_a31gf")
text = "Les troubles du sommeil peuvent affecter gravement la consolidation mnésique nocturne."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_a31gf")
text = "Un grave trouble du sommeil peut perturber profondément la conscience lors des actes nocturnes."

