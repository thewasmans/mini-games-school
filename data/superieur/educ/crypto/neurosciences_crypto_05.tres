[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_jp32b")
text = "Le système nerveux central comprend l'encéphale et la moelle épinière."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_jp32b")
text = "L'encéphale est protégé par les trois méninges et le crâne osseux."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_jp32b")
text = "Le système nerveux périphérique est constitué des nerfs crâniens et spinaux."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_jp32b")
text = "Le système somatique perçoit les stimuli et contrôle les mouvements volontaires."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_jp32b")
text = "Le système nerveux autonome est responsable des fonctions automatiques de l'organisme."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_jp32b")
text = "Le système sympathique active la réaction de l'organisme en réponse au stress."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_jp32b")
text = "Le système parasympathique s'active en réponse à la relaxation et favorise la digestion."

[sub_resource type="Resource" id="phrase_8"]
