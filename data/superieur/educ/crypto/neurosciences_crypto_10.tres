script = ExtResource("1_hqm8x")
text = "La conscience implique de réaliser des activités volontaires en activant le lobe frontal."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_hqm8x")
text = "L'inconscience permet de réaliser des activités autonomes sans nécessiter de réflexion consciente."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_hqm8x")
text = "Le système nerveux entérique est souvent qualifié de second cerveau intestinal autonome."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_hqm8x")
