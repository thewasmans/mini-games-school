[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_jlrgt")
text = "Face à un stress, l'hypothalamus envoie un message hormonal à l'hypophyse."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_jlrgt")
text = "L'hypophyse envoie des hormones corticotropes aux glandes surrénales situées sur les reins."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_jlrgt")
text = "La médullosurrénale produit des catécholamines comme l'adrénaline et la noradrénaline."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_jlrgt")
text = "Le système sympathique augmente la fréquence cardiaque et la pression artérielle."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_jlrgt")
text = "Le cortex surrénalien libère le cortisol permettant au foie de libérer du sucre."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_jlrgt")
text = "Une réponse anxieuse chronique et incontrôlable peut induire un trouble d'anxiété généralisée."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_jlrgt")
text = "L'amygdale est le centre nerveux responsable de la peur et de l'anxiété."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_jlrgt")
text = "Paul Ekman identifie six émotions fondamentales universelles chez les êtres humains."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_jlrgt")
text = "Le système de la récompense utilise la dopamine pour motiver les comportements vitaux."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_jlrgt")
text = "L'aire tegmentale ventrale stimule le noyau accumbens pour libérer de la dopamine."

