[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_8ra4o")
text = "Santiago Ramón y Cajal a proposé la théorie neuronale et les synapses."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_8ra4o")
text = "La plupart des synapses sont chimiques et utilisent des neurotransmetteurs spécifiques."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_8ra4o")
text = "Les neurotransmetteurs excitateurs assurent la continuité du signal électrique neuronal."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_8ra4o")
text = "Le glutamate et le GABA constituent près de cinquante pour cent des neurotransmetteurs."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_8ra4o")
text = "Un signal électrique se propage le long de l'axone et arrive au bouton synaptique."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_8ra4o")
text = "L'entrée de cations sodium produit un phénomène de dépolarisation membranaire."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_8ra4o")
text = "L'entrée d'anions chlorure produit un phénomène d'hyperpolarisation inhibant le signal."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_8ra4o")
text = "Le potentiel d'action suit strictement la loi de type tout ou rien."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_8ra4o")
text = "La tétrodotoxine bloque l'ouverture des canaux sodiques empêchant le passage de l'influx."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_8ra4o")
text = "L'abungarotoxine bloque les récepteurs à acétylcholine entraînant une paralysie musculaire."

