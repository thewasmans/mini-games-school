[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_qp4xl")
text = "On recense quatre-vingt-cinq milliards de neurones et cent milliards de cellules gliales."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_qp4xl")
text = "Les neurones sont constitués d'un noyau et de dendrites réceptrices."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_qp4xl")
text = "L'axone conduit l'influx nerveux appelé potentiel d'action vers les boutons synaptiques."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_qp4xl")
text = "Les neurones moteurs transmettent l'information depuis le cerveau jusqu'aux muscles."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_qp4xl")
text = "Les neurones sensoriels font le chemin inverse des récepteurs vers le cerveau."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_qp4xl")
text = "Les astrocytes forment la barrière hémato-encéphalique protégeant le système nerveux."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_qp4xl")
text = "Les oligodendrocytes produisent la gaine de myéline isolant les fibres nerveuses."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_qp4xl")
text = "Les microgliocytes jouent un rôle de macrophages dans le tissu nerveux."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_qp4xl")
text = "Les cellules de Schwann forment l'isolation myélinique dans le système périphérique."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_qp4xl")
text = "La maladie d'Alexander est une mutation génétique impactant le fonctionnement des astrocytes."

