[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_1y6tl")
text = "La cellule eucaryote possède un noyau qui contient l'ADN."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_1y6tl")
text = "Les mitochondries sont les usines énergétiques des cellules humaines."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_1y6tl")
text = "Le réticulum endoplasmique synthétise les protéines nécessaires."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_1y6tl")
text = "L'appareil de Golgi modifie et empaquète les molécules."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_1y6tl")
text = "Les lysosomes digèrent les déchets et débris cellulaires."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_1y6tl")
text = "Les neurones possèdent environ dix mille synapses chacun."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_1y6tl")
text = "Les cellules gliales soutiennent et protègent les neurones."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_1y6tl")
text = "Le corps humain contient environ trente sept virgule deux milliards de cellules."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_1y6tl")
text = "Les niveaux d'organisation vont de la cellule à l'organisme entier."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_1y6tl")
text = "L'homéostasie maintient l'équilibre des conditions internes du corps."

