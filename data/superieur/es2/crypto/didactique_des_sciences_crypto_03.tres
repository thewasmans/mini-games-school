[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_rug61")
text = "La feuille effectue la photosynthèse pour produire l'énergie."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_rug61")
text = "La tige assure la structure et le soutien de la plante."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_rug61")
text = "La racine fixe la plante au sol et absorbe les nutriments."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_rug61")
text = "Les stomates sont de petits pores qui régulent les échanges gazeux."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_rug61")
text = "Le xylème transporte la sève brute riche en eau et minéraux."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_rug61")
text = "Le phloème transporte la sève élaborée riche en sucres et nutriments."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_rug61")
text = "Les plantes sans fleurs sont appelées cryptogames ou spores."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_rug61")
text = "Les plantes à fleurs sont appelées phanérogames ou phanérogames."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_rug61")
text = "Les plantes sont apparues sur terre il y a quatre cents millions d'années."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_rug61")
text = "Les mousses et lichens ont colonisé le sol terrestre il y a quatre cent vingt millions d'années."

