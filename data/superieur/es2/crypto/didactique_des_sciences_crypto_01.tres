[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_ixxup")
text = "Le Big Bang s'est produit il y a dix à quinze milliards d'années."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_ixxup")
text = "Notre système solaire s'est formé il y a quatre milliards d'années."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_ixxup")
text = "Les bactéries sont apparues il y a trois virgule huit cinq milliards d'années."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_ixxup")
text = "Les algues bleues réalisent la photosynthèse et produisent l'oxygène."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_ixxup")
text = "Les premiers vertébrés aquatiques sont apparus il y a quatre cent vingt millions d'années."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_ixxup")
text = "Le dinosaure a prospéré durant l'ère secondaire ou Mésozoïque."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_ixxup")
text = "La Pangée était le supercontinent durant l'époque des dinosaures."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_ixxup")
text = "Les mammifères se sont développés il y a soixante millions d'années."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_ixxup")
text = "Homo sapiens est apparu il y a environ deux cent mille ans."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_ixxup")
text = "Néandertal et Homo floresiensis ont disparu à différentes périodes."

