[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_ljhvv")
text = "Le cœur pompe le sang vers les artères et les organes."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_ljhvv")
text = "Les artères transportent le sang riche en oxygène du cœur."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_ljhvv")
text = "Les veines retournent le sang pauvre en oxygène au cœur."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_ljhvv")
text = "Les capillaires permettent les échanges de nutriments avec les tissus."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_ljhvv")
text = "Le sang oxygéné circule dans la grande circulation pulmonaire."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_ljhvv")
text = "Les poumons captent l'oxygène de l'air inspiré par les alvéoles."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_ljhvv")
text = "La trachée conduit l'air vers les bronches puis les poumons."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_ljhvv")
text = "Les alvéoles pulmonaires sont le siège des échanges gazeux."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_ljhvv")
text = "L'hémoglobine transporte l'oxygène dans les globules rouges."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_ljhvv")
text = "Le dioxyde de carbone s'échange contre l'oxygène aux alvéoles."

