[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_vnmjc")
text = "La salive contient de l'amylase qui commence à digérer les glucides."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_vnmjc")
text = "L'estomac secrète de la pepsine pour digérer les protéines."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_vnmjc")
text = "L'intestin grêle absorbe les nutriments dans le sang et la lymphe."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_vnmjc")
text = "Le pancréas produit les enzymes digestives et l'insuline."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_vnmjc")
text = "Le foie stocke le glycogène et synthétise l'urée et les protéines."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_vnmjc")
text = "Les protéines sont les briques de base de tous les tissus corporels."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_vnmjc")
text = "Les lipides fournissent l'énergie et forment les membranes cellulaires."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_vnmjc")
text = "Les glucides sont la source principale d'énergie du corps humain."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_vnmjc")
text = "Les vitamines et minéraux régulent les fonctions métaboliques."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_vnmjc")
text = "Le microbiote intestinal aide à la digestion et l'absorption des nutriments."

