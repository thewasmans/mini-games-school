[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_hjqur")
text = "Le squelette compte deux cent six os chez l'adulte."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_hjqur")
text = "Les os longs comme le fémur supportent le poids du corps."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_hjqur")
text = "Les articulations permettent les mouvements fluides des os."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_hjqur")
text = "Les cartilages cushionnent les articulations et réduisent les frictions."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_hjqur")
text = "Les muscles striés permettent les mouvements volontaires du corps."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_hjqur")
text = "Les muscles lisses assurent les fonctions autonomes des organes."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_hjqur")
text = "Le muscle cardiaque pompe le sang en contraction permanente."

[sub_resource type="Resource" id="phrase_8"]
script = ExtResource("1_hjqur")
text = "Les tendons relient les muscles aux os du squelette."

[sub_resource type="Resource" id="phrase_9"]
script = ExtResource("1_hjqur")
text = "La contraction musculaire se produit grâce au calcium ionique."

[sub_resource type="Resource" id="phrase_10"]
script = ExtResource("1_hjqur")
text = "L'atrophie musculaire survient sans stimulation ou influx nerveux."

