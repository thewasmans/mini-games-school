[sub_resource type="Resource" id="phrase_1"]
script = ExtResource("1_ds52a")
text = "L'être humain est un animal mammifère appartenant à la classe des vertébrés."

[sub_resource type="Resource" id="phrase_2"]
script = ExtResource("1_ds52a")
text = "L'homéostasie maintient l'équilibre des conditions internes constantes."

[sub_resource type="Resource" id="phrase_3"]
script = ExtResource("1_ds52a")
text = "L'évolution s'observe dans l'adaptation des systèmes biologiques."

[sub_resource type="Resource" id="phrase_4"]
script = ExtResource("1_ds52a")
text = "La conscience et la pensée émergent de l'activité du cortex préfrontal."

[sub_resource type="Resource" id="phrase_5"]
script = ExtResource("1_ds52a")
text = "L'inconscient influence nos comportements et nos décisions."

[sub_resource type="Resource" id="phrase_6"]
script = ExtResource("1_ds52a")
text = "La place de l'humain dans la biodiversité en fait un animal responsable."

[sub_resource type="Resource" id="phrase_7"]
script = ExtResource("1_ds52a")
text = "Les gènes transmettent les caractéristiques d'une génération à l'autre."

[sub_resource type="Resource" id="phrase_8"]
