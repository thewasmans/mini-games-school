[sub_resource type="Resource" id="Resource_5nmkx"]
script = ExtResource("1_p20ew")
question = "Qu’est-ce qu’un champ magnétique ?"
choices = Array[String](["C’est une zone où une aiguille aimantée subit une force.", "C’est une zone où un objet en plastique est attiré.", "C’est une zone où l’air est ionisé.", "C’est une zone où la gravité est plus forte."])

[sub_resource type="Resource" id="Resource_rchgg"]
script = ExtResource("1_p20ew")
question = "Quel est le sens conventionnel des lignes de champ magnétique à l’extérieur d’un aimant ?"
choices = Array[String](["Du pôle Sud vers le pôle Nord.", "Du pôle Nord vers le pôle Sud.", "De l’Est vers l’Ouest.", "Du centre vers l’extérieur."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_ikmck"]
script = ExtResource("1_p20ew")
question = "Que se passe-t-il lorsque l’on approche deux pôles de même nature (Nord et Nord) ?"
choices = Array[String](["Ils s’attirent.", "Ils se repoussent.", "Ils ne réagissent pas.", "Le champ magnétique disparaît."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_tf7v3"]
script = ExtResource("1_p20ew")
question = "Quelle est l’expérience historique qui a prouvé le lien entre électricité et magnétisme ?"
choices = Array[String](["L’expérience de Newton.", "L’expérience de Faraday.", "L’expérience d’Oersted.", "L’expérience de Joule."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_04dxe"]
script = ExtResource("1_p20ew")
question = "Quelle est la forme des lignes de champ magnétique autour d’un fil rectiligne parcouru par un courant ?"
choices = Array[String](["Ce sont des cercles concentriques.", "Ce sont des lignes droites parallèles.", "Ce sont des rayons partant du fil.", "Ce sont des spirales complexes."])

