[sub_resource type="Resource" id="Resource_bg5s4"]
script = ExtResource("1_t7niv")
question = "Qu'est-ce qu'une réaction irréversible ?"
choices = Array[String](["Une réaction complète.", "Toutes ces réponses sont justes.", "Une réaction qui ne se produit que dans un sens.", "La combustion d'une bougie."])
