[ext_resource type="Script" uid="uid://dcacf80pyq888" path="res://scripts/mini_games/crypto/crypto_phrase_data.gd" id="1_4i6ql"]
[ext_resource type="Script" uid="uid://bd1ufgnv22yot" path="res://scripts/mini_games/crypto/crypto_data.gd" id="2_b61c6"]

[sub_resource type="Resource" id="Resource_al0js"]
script = ExtResource("1_4i6ql")
text = "Une transformation chimique réversible peut évoluer dans les deux sens."

[sub_resource type="Resource" id="Resource_nqkq1"]
script = ExtResource("1_4i6ql")
text = "L'état d'équilibre chimique est atteint lorsque les vitesses directe et inverse s'égalisent."

[sub_resource type="Resource" id="Resource_qecwk"]
script = ExtResource("1_4i6ql")
text = "À l'équilibre"
hint = "les concentrations des réactifs et des produits restent constantes."

[sub_resource type="Resource" id="Resource_oiddf"]
script = ExtResource("1_4i6ql")
text = "La constante d'équilibre Kc caractérise la position d'un équilibre chimique."

[sub_resource type="Resource" id="Resource_4vx2m"]
script = ExtResource("1_4i6ql")
text = "Le quotient de réaction Qr permet de prédire le sens d'évolution d'un système."

[sub_resource type="Resource" id="Resource_7atbe"]
script = ExtResource("1_4i6ql")
text = "Si Qr < Kc"
hint = "le système évolue dans le sens direct de la réaction."

[sub_resource type="Resource" id="Resource_vlsk3"]
script = ExtResource("1_4i6ql")
text = "Le principe de Le Chatelier permet de prévoir le déplacement d'un équilibre."

[sub_resource type="Resource" id="Resource_4p5gf"]
script = ExtResource("1_4i6ql")
text = "Une augmentation de température déplace l'équilibre dans le sens endothermique."

[resource]
script = ExtResource("2_b61c6")
phrases = Array[ExtResource("1_4i6ql")]([SubResource("Resource_al0js"), SubResource("Resource_nqkq1"), SubResource("Resource_qecwk"), SubResource("Resource_oiddf"), SubResource("Resource_4vx2m"), SubResource("Resource_7atbe"), SubResource("Resource_vlsk3"), SubResource("Resource_4p5gf")])
