[sub_resource type="Resource" id="Resource_evj23"]
script = ExtResource("1_grruk")
text = "La chimie organique étudie les composés à base de carbone."

[sub_resource type="Resource" id="Resource_03pf4"]
script = ExtResource("1_grruk")
text = "Les hydrogénocarbones ne contiennent que du carbone et de l'hydrogène."

[sub_resource type="Resource" id="Resource_r4urb"]
script = ExtResource("1_grruk")
text = "Les alcanes sont des hydrocarbures saturés à liaisons simples."

[sub_resource type="Resource" id="Resource_7j7uf"]
script = ExtResource("1_grruk")
text = "Les alcènes possèdent au moins une double liaison carbone."

[sub_resource type="Resource" id="Resource_c5glo"]
script = ExtResource("1_grruk")
text = "Les alcynes comportent au moins une triple liaison carbone."

[sub_resource type="Resource" id="Resource_jd52p"]
script = ExtResource("1_grruk")
text = "La formule brute indique la nature et le nombre d'atomes."

[sub_resource type="Resource" id="Resource_cymu3"]
script = ExtResource("1_grruk")
text = "Les formules développées et semi-développées montrent l'enchaînement."

[sub_resource type="Resource" id="Resource_ydhw0"]
script = ExtResource("1_grruk")
text = "La nomenclature IUPAC permet de nommer précisément les molécules."

