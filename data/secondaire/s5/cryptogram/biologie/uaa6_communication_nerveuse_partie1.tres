[sub_resource type="Resource" id="Resource_fi0tp"]
script = ExtResource("1_bs40h")
text = "Le système nerveux central comprend l'encéphale et la moelle épinière."

[sub_resource type="Resource" id="Resource_cqaaa"]
script = ExtResource("1_bs40h")
text = "Le système nerveux périphérique relie les organes aux centres nerveux."

[sub_resource type="Resource" id="Resource_88ogp"]
script = ExtResource("1_bs40h")
text = "Le neurone est l'unité cellulaire fonctionnelle du tissu nerveux."

[sub_resource type="Resource" id="Resource_31din"]
script = ExtResource("1_bs40h")
text = "Les dendrites reçoivent les messages nerveux entrants."

[sub_resource type="Resource" id="Resource_sg6dm"]
script = ExtResource("1_bs40h")
text = "L'axone transmet le message nerveux sous forme de potentiel d'action."

[sub_resource type="Resource" id="Resource_rfvln"]
script = ExtResource("1_bs40h")
text = "La gaine de myéline accélère la conduction de l'influx nerveux."

[sub_resource type="Resource" id="Resource_tycu2"]
script = ExtResource("1_bs40h")
text = "La synapse assure la transmission chimique entre deux neurones."

[sub_resource type="Resource" id="Resource_opar5"]
script = ExtResource("1_bs40h")
text = "Les neurotransmetteurs libérés traversent la fente synaptique."

