[sub_resource type="Resource" id="Resource_e5iem"]
script = ExtResource("1_t41ib")
text = "Les aliments fournissent à l'organisme l'énergie et les nutriments nécessaires."

[sub_resource type="Resource" id="Resource_i03te"]
script = ExtResource("1_t41ib")
text = "La digestion transforme les aliments en nutriments assimilables par le sang."

[sub_resource type="Resource" id="Resource_ddl1m"]
script = ExtResource("1_t41ib")
text = "Les enzymes facilitent la décomposition chimique des aliments."

[sub_resource type="Resource" id="Resource_16m5o"]
script = ExtResource("1_t41ib")
text = "L'intestin grêle assure l'absorption des nutriments dans la circulation sanguine."

[sub_resource type="Resource" id="Resource_36gvc"]
script = ExtResource("1_t41ib")
text = "Les vitamines et les minéraux sont indispensables au bon fonctionnement cellulaire."

[sub_resource type="Resource" id="Resource_3clla"]
script = ExtResource("1_t41ib")
text = "Une alimentation équilibrée associe tous les groupes d'aliments en bonnes proportions."

[sub_resource type="Resource" id="Resource_soc2j"]
script = ExtResource("1_t41ib")
text = "L'eau est essentielle pour hydrater le corps et transporter les nutriments."

[sub_resource type="Resource" id="Resource_lwsnq"]
script = ExtResource("1_t41ib")
text = "L'activité physique et une alimentation saine préservent la santé."

