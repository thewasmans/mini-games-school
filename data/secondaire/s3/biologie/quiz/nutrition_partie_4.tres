question = "Pourquoi les fibres alimentaires sont-elles importantes ?"
choices = Array[String](["Pour favoriser le transit intestinal.", "Pour donner de la force immédiate.", "Pour réduire le cholestérol totalement.", "Elles ne sont pas utiles."])

