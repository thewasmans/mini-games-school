[sub_resource type="Resource" id="Resource_bo2nd"]
script = ExtResource("1_qw2q8")
text = "La pression correspond à une force exercée sur une surface."

[sub_resource type="Resource" id="Resource_dsepn"]
script = ExtResource("1_qw2q8")
text = "L'unité légale de pression est le pascal."

[sub_resource type="Resource" id="Resource_my0hq"]
script = ExtResource("1_qw2q8")
text = "Plus la surface de contact est petite"
hint = "plus la pression est grande."

[sub_resource type="Resource" id="Resource_2ev4o"]
script = ExtResource("1_qw2q8")
text = "La pression atmosphérique est due au poids de l'air environnant."

[sub_resource type="Resource" id="Resource_kntsg"]
script = ExtResource("1_qw2q8")
text = "La pression dans les liquides augmente avec la profondeur."

[sub_resource type="Resource" id="Resource_c7s2c"]
script = ExtResource("1_qw2q8")
text = "Un gaz exerce une pression en frappant les parois du récipient."

[sub_resource type="Resource" id="Resource_gtghu"]
script = ExtResource("1_qw2q8")
text = "Le baromètre est l'instrument utilisé pour mesurer la pression atmosphérique."

[sub_resource type="Resource" id="Resource_dcqyq"]
script = ExtResource("1_qw2q8")
text = "Les plongeurs subissent une pression croissante sous l'eau."

[sub_resource type="Resource" id="Resource_rqf0k"]
script = ExtResource("1_qw2q8")
text = "Une force pressante se calcule en divisant la force par la surface."

[sub_resource type="Resource" id="Resource_3qc3m"]
