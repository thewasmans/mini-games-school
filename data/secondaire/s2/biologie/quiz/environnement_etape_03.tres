[sub_resource type="Resource" id="Resource_t3ho0"]
script = ExtResource("1_m3mwf")
question = "Quel phénomène naturel est renforcé par les activités humaines ?"
choices = Array[String](["L'effet de serre.", "L'érosion des sols.", "La tectonique des plaques.", "L'inversion magnétique."])

[sub_resource type="Resource" id="Resource_oruux"]
script = ExtResource("1_m3mwf")
question = "Que mesure l'indicateur appelé \"empreinte écologique\" ?"
choices = Array[String](["La quantité de déchets plastiques dans les océans.", "La surface nécessaire pour produire ce qu'un individu consomme et absorber ses déchets.", "Le taux de dioxyde de carbone rejeté par une usine.", "Le nombre d'espèces animales menacées d'extinction."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_5r266"]
script = ExtResource("1_m3mwf")
question = "Quel est l'objectif principal du développement durable ?"
choices = Array[String](["Répondre aux besoins du présent.", "Stopper totalement toute industrialisation humaine.", "Maximiser les profits économiques à court terme.", "Remplacer toutes les forêts par des cultures agricoles."])

[sub_resource type="Resource" id="Resource_e5w8q"]
script = ExtResource("1_m3mwf")
question = "Quelle infrastructure humaine est la cause majeure de la fragmentation des habitats naturels ?"
choices = Array[String](["La construction de routes et d'autoroutes.", "L'installation de panneaux solaires dans les déserts.", "La plantation d'arbres fruitiers dans les jardins.", "Le développement de sentiers pédestres balisés."])

[sub_resource type="Resource" id="Resource_iqmsb"]
script = ExtResource("1_m3mwf")
question = "Pourquoi l'introduction d'une espèce exotique envahissante perturbe-t-elle l'écosystème local ?"
choices = Array[String](["Elle nettoie les rivières de toute pollution.", "Elle concurrence et menace les espèces indigènes locales.", "Elle diminue automatiquement la température de l'eau.", "Elle augmente la fertilité des sols en quelques semaines."])
correct_choice_index = 1

