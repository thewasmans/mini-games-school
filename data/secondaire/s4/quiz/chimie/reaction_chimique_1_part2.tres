[sub_resource type="Resource" id="Resource_p46kd"]
script = ExtResource("1_gc5mq")
question = "Qu'est-ce qu'un corps pur composé ?"
choices = Array[String](["Atomes liés ensemble suite à une réaction chimique, comme l'eau.", "Deux ou plusieurs substances qui sont physiquement mêlées.", "Se dit d'un mélange si on ne peut pas distinguer ses différents constituants à l’oeil nu.", "Assemblage d’atomes d’un seul élément."])

[sub_resource type="Resource" id="Resource_mietl"]
script = ExtResource("1_gc5mq")
question = "Qu'est-ce qu'un mélange homogène ?"
choices = Array[String](["Atomes liés ensemble suite à une réaction chimique, comme l'eau.", "deux ou plusieurs substances qui sont physiquement mêlées.", "Se dit d'un mélange si on ne peut pas distinguer ses différents constituants à l’oeil nu.", "Assemblage d’atomes d’un seul élément."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_j2yys"]
script = ExtResource("1_gc5mq")
question = "Qu'est-ce qu'une solution ?"
choices = Array[String](["Se dit de la substance qui va être dissoute.", "Se dit de la substance qui va dissoudre le composé.", "Se dit du résultat entre le solvant et le soluté.", "Se dit de la réaction chimique qui se produit pour obtenir une solution complète."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_ef4il"]
script = ExtResource("1_gc5mq")
question = "En quoi consiste la décantation ?"
choices = Array[String](["Cette méthode permet de recueillir le solide dans le filtre et d’obtenir un liquide appelé filtrat.", "Procédé qui consiste à débarrasser un liquide de ses impuretés lourdes en les laissant se déposer sur le fond.", "Procédé qui consiste à faire tourner le mélange autour d’un axe de rotation.", "Procédé par lequel un mélange est chauffé dans un système fermé."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_aah71"]
script = ExtResource("1_gc5mq")
question = "Que représente le numéro atomique ?"
choices = Array[String](["Le nombre d'électrons.", "Le nombre de protons.", "Aucune de ces réponses.", "Le symbole de l'élément."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_6fbe4"]
script = ExtResource("1_gc5mq")
question = "Qu'est-ce que la concentration molaire ?"
choices = Array[String](["C'est la masse de soluté présente dans un litre de la solution.", "Le nombre d'électrons de l'élément.", "Les différents isotopes d'un élément.", "C'est la quantité de matière dissoute dans un litre de solution."])
correct_choice_index = 3

[sub_resource type="Resource" id="Resource_x6uh0"]
script = ExtResource("1_gc5mq")
question = "Quel est l'objectif de la dilution ?"
choices = Array[String](["Diminuer la concentration d'une solution en y ajoutant du solvant.", "Augmenter la concentration d'une solution en y ajoutant du solvant.", "Augmenter la quantité de solvant.", "Transformer un corps solide en liquide."])

