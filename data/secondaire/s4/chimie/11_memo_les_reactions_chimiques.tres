question = "Quelle est la loi de Lavoisier ?"
answers = PackedStringArray("Dans toute réaction chimique, la masse totale des réactifs est égale à la masse totale des produits.", "Dans toute réaction chimique, la masse totale des réactifs est égale à la masse totale des réactifs.", "Dans toute réaction chimique, il y a équilibre.", "Dans toute réaction chimique, on perd de la matière.")

