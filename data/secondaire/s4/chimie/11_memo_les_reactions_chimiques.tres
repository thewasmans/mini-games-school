[sub_resource type="Resource" id="Resource_kfc8k"]
script = ExtResource("1_kfc8k")
question = "Qu'est-ce qu'un corps pur composé ?"
answers = PackedStringArray("Atomes liés ensemble suite à une réaction chimique, comme l\'eau.", "Deux ou plusieurs substances qui sont physiquement mêlées.", "Se dit d\'un mélange si on ne peut pas distinguer ses différents constituants à l’oeil nu.", "Assemblage d’atomes d’un seul élément.")

