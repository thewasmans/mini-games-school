question = "Dans le couple acide-base HCl / Cl⁻, quelle est la base conjuguée ?"
choices = Array[String](["La base conjuguée est l’ion hydrogène.", "La base conjuguée est la molécule d’eau.", "La base conjuguée est l’ion chlorure.", "La base conjuguée est la molécule d’acide chlorhydrique."])
correct_choice_index = 2

