[sub_resource type="Resource" id="Resource_q8oew"]
script = ExtResource("1_d51b1")
question = "Selon la définition de Brønsted, qu’est-ce qu’un acide ?"
choices = Array[String](["C’est une espèce chimique capable de céder un proton.", "C’est une espèce chimique capable de céder un électron.", "C’est une espèce chimique capable de capter un proton.", "C’est une espèce chimique capable de capter un électron."])

[sub_resource type="Resource" id="Resource_2jqw2"]
script = ExtResource("1_d51b1")
question = "Selon la définition de Brønsted, qu’est-ce qu’une base ?"
choices = Array[String](["C’est une espèce chimique capable de céder un proton.", "C’est une espèce chimique capable de céder un électron.", "C’est une espèce chimique capable de capter un proton.", "C’est une espèce chimique capable de capter un électron."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_kqblc"]
script = ExtResource("1_d51b1")
question = "Qu’est-ce qu’une espèce chimique amphotère ou ampholyte ?"
choices = Array[String](["C’est une espèce chimique qui ne peut pas réagir.", "C’est une espèce chimique qui peut agir soit comme un acide, soit comme une base.", "C’est une espèce chimique qui est totalement insoluble dans l’eau.", "C’est une espèce chimique qui ne contient jamais d’atome d’hydrogène."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_hvk45"]
script = ExtResource("1_d51b1")
question = "Quelle est la définition usuelle du pH ?"
choices = Array[String](["C’est le logarithme négatif de la concentration en ions hydronium.", "C’est le logarithme de la concentration en ions hydronium.", "C’est le logarithme négatif de la concentration en ions hydroxyde.", "C’est la valeur 14 moins le log de la concentration en ions hydronium."])

[sub_resource type="Resource" id="Resource_3x83d"]
script = ExtResource("1_d51b1")
question = "Quel est le pH d’une solution aqueuse neutre à 25 °C ?"
choices = Array[String](["Le pH est égal à zéro.", "Le pH est égal à un.", "Le pH est égal à sept.", "Le pH est égal à quatorze."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_cwj4o"]
script = ExtResource("1_d51b1")
question = "Quels sont les produits formés lors de la réaction entre un acide et une base ?"
choices = Array[String](["Il se forme un dégagement gazeux et de l’eau.", "Il se forme un sel et de l’eau.", "Il se forme uniquement un précipité.", "Il se forme une molécule d’ester."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_ttl77"]
