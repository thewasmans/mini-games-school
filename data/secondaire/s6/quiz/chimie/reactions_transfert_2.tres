choices = Array[String](["Elle sert à ajouter des ions supplémentaires.", "Elle sert à déterminer la concentration d’un analyte inconnu.", "Elle sert à changer uniquement la couleur du milieu.", "Elle sert à précipiter les ions en solution."])
correct_choice_index = 1

