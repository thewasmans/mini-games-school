[sub_resource type="Resource" id="Resource_diolk"]
script = ExtResource("1_s66me")
question = "En quoi consiste la biomanipulation ?"
choices = Array[String](["Modification d'un écosystème en ajoutant ou en supprimant des espèces.", "Manipuler des espèces pour les transformer physiquement.", "Manipuler des espèces pour les transformer physiologiquement.", "Manipuler des espèces pour les transformer génétiquement."])

[sub_resource type="Resource" id="Resource_6h8gt"]
script = ExtResource("1_s66me")
question = "Qu'est-ce qu'un service écologique ?"
choices = Array[String](["Un bénéfice fournit par l'écosystème à l'être humain.", "Un bénéfice fournit par l'être humain à l'écosystème.", "Un service issu de la sélection artificielle.", "Un bénéfice sans retour de l'environnement."])

[sub_resource type="Resource" id="Resource_osds6"]
