question = "A quoi correspond l'empreinte écologique ?"
choices = Array[String](["C'est la surface de la Terre nécessaire pour rendre possible notre mode de vie.", "C'est la surface de la Terre nécessaire à la reproduction.", "C'est la surface de la Terre nécessaire au développement durable.", "C'est la partie de la Terre où l'on vit."])

