[sub_resource type="Resource" id="Resource_ytvqh"]
script = ExtResource("1_js1k2")
question = "Que constate Darwin lors de son voyage sur les îles de Galapagos ?"
choices = Array[String](["La forme du bec des pinsons est en relation avec le type de régime alimentaire.", "Les oiseaux diffèrent par la couleur de l'iris.", "La spéciation n'existe pas.", "Différentes espèces peuvent se reproduire entre elles."])

