[sub_resource type="Resource" id="Resource_knri7"]
script = ExtResource("1_n3iuo")
question = "Comment se définit une communauté biologique ?"
choices = Array[String](["Ce sont des espèces différentes.", "Ce sont des individus de la même espèce.", "Ce sont des peuples exclusivement d'humains.", "Ce sont des espèces interfécondes."])

[sub_resource type="Resource" id="Resource_4usuv"]
script = ExtResource("1_n3iuo")
question = "Quel niveau se situe entre l'espèce et la communauté ?"
choices = Array[String](["La population.", "La biosphère.", "Le biome.", "L'écosystème."])

[sub_resource type="Resource" id="Resource_cku2p"]
script = ExtResource("1_n3iuo")
question = "Quel terme caractérise l'ensemble des espèces d'un environnement ?"
choices = Array[String](["La population.", "La communauté.", "L'écosystème.", "Le biotope."])

[sub_resource type="Resource" id="Resource_mxg67"]
script = ExtResource("1_n3iuo")
question = "Qu'est-ce que la biodiversité ?"
choices = Array[String](["Diversité des animaux.", "Diversité des plantes.", "Diversité des êtres vivants.", "Correspond au biotope."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_wfw0p"]
script = ExtResource("1_n3iuo")
question = "De quoi est composé un écosystème ?"
choices = Array[String](["Par les êtres vivants et leur lieu de vie.", "Uniquement par le lieu de vie.", "Uniquement par le vivant.", "Uniquement par les facteurs abiotiques."])

[sub_resource type="Resource" id="Resource_sy6nc"]
script = ExtResource("1_n3iuo")
question = "Quel impact sur l'environnement n'est pas causé par l'être humain ?"
choices = Array[String](["La déforestation.", "Les marées.", "La surexploitation.", "La pollution."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_iu6gp"]
script = ExtResource("1_n3iuo")
question = "Qu'est-ce qu'une espèce invasive ?"
choices = Array[String](["Une espèce non indigène dont l'introduction constitue une menace.", "Une espèce non indigène dont l'introduction ne constitue pas une menace.", "Une espèce indigène dont l'introduction constitue une menace.", "Une extinction."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_5uwvi"]
script = ExtResource("1_n3iuo")
question = "Que peux-tu dire à propos de la perche du Nil ?"
choices = Array[String](["C'est une espèce invasive.", "C'est une espèce menacée.", "Elle souffre de la surpêche.", "Toutes ces réponses sont justes."])

[sub_resource type="Resource" id="Resource_nqe0x"]
script = ExtResource("1_n3iuo")
question = "Quelles sont les conséquences du changement climatique ?"
choices = Array[String](["Une variation des précipitations et de la température.", "Une augmentation unique des températures.", "Une diminution unique des températures.", "Une augmentation unique de la pluie."])

[sub_resource type="Resource" id="Resource_gh6w7"]
script = ExtResource("1_n3iuo")
question = "Quelle mesure mise en place par l'être humain permet de préserver l'environnement ?"
choices = Array[String](["Le maillage.", "La surpêche.", "La déforestation.", "Le transfert thermique."])

[sub_resource type="Resource" id="Resource_gsh10"]
script = ExtResource("1_n3iuo")
question = "Qu'est-ce qu'une espèce endémique ?"
choices = Array[String](["Une espèce qui ne se retrouve que dans une aire géographique précise.", "Une espèce qui ne se retrouve que dans un milieu aquatique.", "Une espèce qui ne se retrouve que dans un milieu terrestre.", "Une espèce menacée."])

[sub_resource type="Resource" id="Resource_q3nsn"]
