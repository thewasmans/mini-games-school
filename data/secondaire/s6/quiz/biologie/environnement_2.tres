question = "Que signifie l'acronyme UICN ?"
choices = Array[String](["Union Internationale pour la Conservation de la Nature.", "Union Internationale pour la Coopérative de la Nature.", "Union Internationale pour la Conservation de Natura2000.", "Union Internationale pour la Consommation de la Nature."])

[sub_resource type="Resource" id="Resource_gcyyv"]
script = ExtResource("1_n3iuo")
question = "Qu'est-ce qu'une espèce menacée ?"
choices = Array[String](["Une espèce qui risque de s'éteindre.", "Une espèce qui a disparue.", "Une espèce quasi éteinte.", "Une espèce endémique."])

