question = "Qu’est-ce que l’amplitude d’une onde ?"
choices = Array[String](["C’est la distance entre deux crêtes successives.", "C’est le déplacement maximal par rapport à la position d’équilibre.", "C’est la vitesse de propagation de l’onde.", "C’est la durée nécessaire pour parcourir une distance."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_klgdf"]
script = ExtResource("1_kidqq")
question = "Qu’est-ce qu’une onde transversale ?"
choices = Array[String](["C’est une onde où le déplacement est parallèle à la direction de propagation.", "C’est une onde où le déplacement est perpendiculaire à la direction de propagation.", "C’est une onde qui ne transporte pas d’énergie.", "C’est une onde qui se déplace uniquement dans le vide."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_r51y3"]
script = ExtResource("1_kidqq")
question = "Qu’est-ce qu’une onde longitudinale ?"
choices = Array[String](["C’est une onde où le déplacement est parallèle à la direction de propagation.", "C’est une onde où le déplacement est perpendiculaire à la direction de propagation.", "C’est une onde qui ne peut pas se propager dans l’air.", "C’est une onde qui possède une amplitude nulle."])

[sub_resource type="Resource" id="Resource_cnj0e"]
