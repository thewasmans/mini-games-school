[sub_resource type="Resource" id="Resource_te01m"]
script = ExtResource("1_kidqq")
question = "Qu’est-ce qu’une période dans un mouvement oscillatoire ?"
choices = Array[String](["C’est la distance entre deux sommets.", "C’est la durée d’une oscillation complète.", "C’est le nombre d’oscillations par seconde.", "C’est l’amplitude maximale du mouvement."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_06mss"]
script = ExtResource("1_kidqq")
question = "Comment définit-on la fréquence d’une onde ?"
choices = Array[String](["C’est le temps mis pour faire un cycle.", "C’est le nombre de cycles par unité de temps.", "C’est la distance parcourue par l’onde.", "C’est la hauteur maximale de l’onde."])
correct_choice_index = 1

[sub_resource type="Resource" id="Resource_e6mn1"]
script = ExtResource("1_kidqq")
question = "Quelle est l’unité de mesure de la fréquence dans le système international ?"
choices = Array[String](["Le mètre.", "La seconde.", "Le hertz.", "Le joule."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_0smgx"]
script = ExtResource("1_kidqq")
question = "Quelle est la relation mathématique entre la période T et la fréquence f ?"
choices = Array[String](["La fréquence est égale à la période.", "La fréquence est égale à la période multipliée par deux.", "La fréquence est égale à l’inverse de la période.", "La fréquence est égale à la période au carré."])
correct_choice_index = 2

[sub_resource type="Resource" id="Resource_e04xq"]
