[sub_resource type="Resource" id="Resource_mmyy0"]
script = ExtResource("1_ft5jb")
text = "Un mouvement périodique se répète à intervalles réguliers."

[sub_resource type="Resource" id="Resource_ctc1g"]
script = ExtResource("1_ft5jb")
text = "La période est la durée d'un cycle complet."

[sub_resource type="Resource" id="Resource_iat3m"]
script = ExtResource("1_ft5jb")
text = "La fréquence mesure le nombre de cycles par seconde."

[sub_resource type="Resource" id="Resource_r4kl6"]
script = ExtResource("1_ft5jb")
text = "L'élongation représente le déplacement à chaque instant."

[sub_resource type="Resource" id="Resource_e6or8"]
script = ExtResource("1_ft5jb")
text = "L'amplitude est l'élongation maximale du mouvement."

[sub_resource type="Resource" id="Resource_htgau"]
script = ExtResource("1_ft5jb")
text = "Le pendule simple oscille sous l'effet du poids."

