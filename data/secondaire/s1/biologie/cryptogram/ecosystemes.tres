text = "Les végétaux producteurs fabriquent leur matière."

[sub_resource type="Resource" id="Resource_b28sq"]
script = ExtResource("1_taqhf")
text = "Les consommateurs se nourrissent d'autres êtres."

[sub_resource type="Resource" id="Resource_xth16"]
