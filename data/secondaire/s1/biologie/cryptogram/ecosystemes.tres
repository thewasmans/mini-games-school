[sub_resource type="Resource" id="Resource_2bea4"]
script = ExtResource("1_taqhf")
text = "Un écosystème associe un milieu et des êtres vivants."

[sub_resource type="Resource" id="Resource_wn8b3"]
script = ExtResource("1_taqhf")
text = "Les êtres vivants interagissent dans leur milieu."

[sub_resource type="Resource" id="Resource_rmoib"]
script = ExtResource("1_taqhf")
text = "La biodiversité désigne la variété du vivant."

[sub_resource type="Resource" id="Resource_ja7yf"]
script = ExtResource("1_taqhf")
text = "Les chaînes alimentaires lient les organismes."

[sub_resource type="Resource" id="Resource_6531l"]
