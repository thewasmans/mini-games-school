[sub_resource type="Resource" id="Resource_44tnh"]
script = ExtResource("1_jv04s")
text = "L'énergie est nécessaire pour effectuer un travail ou produire de la chaleur."

[sub_resource type="Resource" id="Resource_wuejq"]
script = ExtResource("1_jv04s")
text = "Les sources d'énergie renouvelables se régénèrent naturellement."

[sub_resource type="Resource" id="Resource_sfb0y"]
script = ExtResource("1_jv04s")
text = "Le soleil"
hint = "le vent et l'eau fournissent des énergies renouvelables."

[sub_resource type="Resource" id="Resource_x2cnn"]
script = ExtResource("1_jv04s")
text = "Les combustibles fossiles sont issus de la décomposition d'organismes."

[sub_resource type="Resource" id="Resource_p3enr"]
script = ExtResource("1_jv04s")
text = "Le pétrole"
hint = "le charbon et le gaz sont des énergies non renouvelables."

[sub_resource type="Resource" id="Resource_13abd"]
script = ExtResource("1_jv04s")
text = "L'énergie nucléaire provient de la fission d'atomes d'uranium."

[sub_resource type="Resource" id="Resource_1j4m1"]
script = ExtResource("1_jv04s")
text = "L'électricité est une forme d'énergie secondaire très utilisée."

[sub_resource type="Resource" id="Resource_x8rwn"]
script = ExtResource("1_jv04s")
text = "La consommation d'énergie fossile émet des gaz à effet de serre."

[sub_resource type="Resource" id="Resource_bgcqg"]
script = ExtResource("1_jv04s")
text = "La transition énergétique vise à privilégier les énergies propres."

[sub_resource type="Resource" id="Resource_5j265"]
script = ExtResource("1_jv04s")
text = "L'efficacité énergétique permet d'économiser nos ressources."

[resource]
